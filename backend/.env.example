# Where demo services send telemetry (A's OTLP HTTP ingestion = :4318, gRPC = :4317)
OTLP_HTTP_ENDPOINT=http://localhost:4318
OTLP_GRPC_ENDPOINT=http://localhost:4317

# Per-service exporter protocol: json | proto | grpc
# Day 4 check: 2 services on gRPC, 2 on HTTP (defaults below)
GATEWAY_PROTOCOL=json
CART_PROTOCOL=json
INVENTORY_PROTOCOL=json
PAYMENT_PROTOCOL=json

# Load generator
GATEWAY_URL=http://localhost:3000
